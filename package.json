{
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"NODE_ENV=development APP_BASE_URL=http://localhost:5193 PAYPAL_BOOKING_DEPOSITS_ENABLED=false npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:full": "npm run dev",
    "dev:vite": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "server": "npm run start -w backend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "nodemailer": "^9.0.3"
  }
  
}
