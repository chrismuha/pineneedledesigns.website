# BEGIN MCR shared ignore rules
# Dependencies
node_modules/

# Logs and runtime files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pids/
*.pid
*.pid.lock
*.seed

# Local environment files
.env
.env.*
!.env.example
*.local

# Test output
coverage/
.nyc_output/
*.lcov

# Tool caches
.cache/
.vite/
.eslintcache
*.tsbuildinfo
.capacitor-sync-state.json

# Temporary workspaces and generated previews
tmp/
temp/

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Compiled and packaged output
dist/
dist-electron/
dist_electron/
out/
.webpack/
build/Release/
release/*
!release/.gitkeep

# Native mobile build output
android/.gradle/
android/**/build/
ios/build/
ios/DerivedData/

# Generated packaging metadata
*.tgz
*.source.sha256
Electron.app/
Electron Framework.framework/

# Operating system and editor files
.DS_Store
**/.DS_Store
**/._*
.idea/
*.swp
*.swo

# Dropbox numbered dependency and conflict copies
node_modules */
*conflicted copy*
# END MCR shared ignore rules

**/.DS_Store
**/._*
/node_modules
frontend/node_modules
backend/node_modules
# MongoDB
.mongodb-data/
*.lock
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
    
node_modules
.DS_Store
dist
frontend/dist
dist-ssr
coverage
*.local

/cypress/videos/
/cypress/screenshots/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.log
*.tsbuildinfo

# Lock files
package-lock.json
yarn.lock

# Runtime session data
.sessions/

# Uploaded product images
backend/uploads/*
!backend/uploads/.gitkeep

# Ignore the legacy HTML folder
legacy-html/

#Ignore environment files (never commit secrets)
.env
**/.env
backend/.env
!.env.example
!**/.env.example
!**/.env.production.example

# Dropbox numbered dependency and conflict copies
node_modules */
*conflicted copy*
