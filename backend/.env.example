# =============================================================================
# DEVELOPMENT — copy to backend/.env for local work
# =============================================================================
PORT=3001
NODE_ENV=development

# MongoDB (local):
# MONGODB_URI=mongodb://127.0.0.1:27017/pineneedledesigns
#
# MongoDB (DigitalOcean Managed). Never commit the real URI.
# Path after the host is the application database. Keep authSource=admin.
# DigitalOcean's copied string often uses /admin — change that path to /pineneedledesigns
# unless existing production data already lives in the admin database.
MONGODB_URI=mongodb+srv://<username>:<password>@<host>/<database>?authSource=admin&replicaSet=<replicaSet>&tls=true

SESSION_SECRET=local-development-only
APP_BASE_URL=http://localhost:5203
# Development fallback for database records whose uploaded media lives on production.
PRODUCTION_MEDIA_ORIGIN=https://pineneedledesigns.store

# PayPal (use SANDBOX_* locally)
PAYPAL_BOOKING_DEPOSITS_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
SANDBOX_PAYPAL_CLIENT_ID=
SANDBOX_PAYPAL_CLIENT_SECRET=

# Clover Hosted Checkout (backend-only — never expose to frontend/Vite)
# Create tokens in Clover Merchant Dashboard → Settings → Ecommerce → Hosted Checkout.
CLOVER_ENVIRONMENT=sandbox
CLOVER_MERCHANT_ID=
# Private Ecommerce API token used as Bearer authorization.
CLOVER_ACCESS_TOKEN=
# Optional custom Hosted Checkout page UUID.
CLOVER_PAGE_CONFIG_UUID=
# Webhook signing secret from Hosted Checkout settings.
CLOVER_WEBHOOK_SECRET=
# Enable Clover booking deposits for fitting/brides appointments by default.
# Set to false only if those links should bypass payment and open the calendar directly.
CLOVER_BOOKING_DEPOSITS_ENABLED=true
# APP_BASE_URL must be https for Clover redirect URLs (use ngrok locally if needed).

# Email (local: Gmail SMTP; leave RESEND empty)
RESEND_API_KEY=
RESEND_FROM=orders@pineneedledesigns.store
EMAIL=
EMAIL_APP_PASSWORD=
ORDER_EMAILS=

# =============================================================================
# PRODUCTION — do NOT put these in backend/.env on the server
# Set them as GitHub Actions Secrets (Settings → Secrets and variables → Actions)
# Deploy workflow injects them into PM2 on the DigitalOcean Droplet
# =============================================================================
#
# Required GitHub Secrets:
#
# DO_HOST                  = Droplet IP or hostname
# DO_USER                  = SSH user (usually root)
# DO_SSH_KEY               = Private SSH key
# MONGODB_URI              = DigitalOcean Managed MongoDB URI (GitHub secret → backend/.env / PM2)
# SESSION_SECRET           = Long random string (not "local-development-only")
# RESEND_API_KEY           = re_... from resend.com
#
# Optional GitHub Secrets:
#
# PAYPAL_BOOKING_DEPOSITS_ENABLED = true or false
# PAYPAL_CLIENT_ID                  = Live PayPal client ID
# PAYPAL_CLIENT_SECRET              = Live PayPal secret
#
# Optional GitHub Variable (not secret):
#
# RESEND_FROM = orders@pineneedledesigns.store
# CLOUDFLARE_ACCESS_TEAM_DOMAIN = chrismuha.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD = 3d74f00031bbb04310c544962709dc773d85c1c71c7fd1c86d6d2b4ce14df5eb
#
# Production MONGODB_URI (DigitalOcean → Databases → Connection details):
# mongodb+srv://<username>:<password>@<host>/<database>?authSource=admin&replicaSet=<replicaSet>&tls=true
#
# Production defaults (no secret needed — set by deploy workflow / code):
# NODE_ENV=production
# APP_BASE_URL=https://pineneedledesigns.store
# PORT=3001
