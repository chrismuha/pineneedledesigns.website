# Reference only — copy values into GitHub Actions Secrets
# Repo: Settings → Secrets and variables → Actions → New repository secret

DO_HOST=
DO_USER=root
DO_SSH_KEY=

# DigitalOcean MongoDB — set as GitHub Actions secret MONGODB_URI (never commit the real URI)
# Droplet on the same VPC: use the VPC/private connection string
# Local or public access: use the Public network connection string
# Path after the host is the application database; keep authSource=admin
MONGODB_URI=mongodb+srv://<username>:<password>@<host>/<database>?authSource=admin&replicaSet=<replicaSet>&tls=true

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# Cloudflare Zero Trust Access application settings (not secrets).
CLOUDFLARE_ACCESS_TEAM_DOMAIN=chrismuha.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=3d74f00031bbb04310c544962709dc773d85c1c71c7fd1c86d6d2b4ce14df5eb

RESEND_API_KEY=
RESEND_FROM=orders@pineneedledesigns.store
EMAIL=
EMAIL_APP_PASSWORD=
ORDER_EMAILS=

PAYPAL_BOOKING_DEPOSITS_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Clover Hosted Checkout (GitHub Actions secrets — backend-only)
CLOVER_ENVIRONMENT=production
CLOVER_MERCHANT_ID=
CLOVER_ACCESS_TOKEN=
CLOVER_PAGE_CONFIG_UUID=
CLOVER_WEBHOOK_SECRET=
CLOVER_BOOKING_DEPOSITS_ENABLED=true
