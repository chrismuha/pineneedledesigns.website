# Copy to backend/.env for local development. Never commit real credentials.
# MONGODB_URI is set only in backend/.env (not here) to avoid conflicting passwords.
SESSION_SECRET=local-development-only
PORT=3001
APP_BASE_URL=http://localhost:5196
VAPID_PUBLIC_KEY=generate-with-npx-web-push-generate-vapid-keys
VAPID_PRIVATE_KEY=keep-this-secret
VAPID_SUBJECT=mailto:orders@pineneedledesigns.store

# Email (local: Gmail SMTP; production: Resend)
RESEND_API_KEY=
RESEND_FROM=
EMAIL=
EMAIL_APP_PASSWORD=
ORDER_EMAILS=

# Clover Hosted Checkout (backend-only)
# Generate in Clover sandbox merchant dashboard → Settings → Ecommerce → Hosted Checkout.
CLOVER_ENVIRONMENT=sandbox
CLOVER_MERCHANT_ID=your_sandbox_merchant_id
CLOVER_ACCESS_TOKEN=your_sandbox_private_ecommerce_token
CLOVER_PAGE_CONFIG_UUID=
# Enable Clover booking deposits for fitting/brides by default.
# Set to false only if those links should go straight to the calendar.
CLOVER_BOOKING_DEPOSITS_ENABLED=true
